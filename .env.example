# Copy to .env (git-ignored) and fill in your own values. Never commit real ones.

# Database. Local Postgres from docker-compose, or a Neon branch for development.
POSTGRES_PASSWORD=choose-a-local-password
DATABASE_URL=postgresql+asyncpg://postgres:choose-a-local-password@localhost:5432/expense_db
# Production only: owner login used by scripts/ensure_schema.py (DATABASE_URL is then the restricted login).
# MIGRATION_DATABASE_URL=

# JWT. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-long-random-value
JWT_ALGORITHM=HS256
JWT_APP_SESSION_DAYS=30

# Firebase Admin (verify phone/Google sign-in, delete users). Paste the service-account JSON as one line.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared secret for the scheduled daily-recap job (POST /internal/daily-recap). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The same value goes in the GitHub repository secret CRON_SECRET; without it the endpoint
# refuses every call, so no recaps are sent.
# CRON_SECRET=

# Optional local-development users (ignored in production). Leave unset to create none.
# DEV_SEED_PASSWORD=
# DEMO_SEED_PASSWORD=

# App config
APP_ENV=development
APP_PORT=8000
# ALLOWED_ORIGINS=  (comma-separated; only needed if a browser client is added again)
