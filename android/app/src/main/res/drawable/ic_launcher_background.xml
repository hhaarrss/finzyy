<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: the splash's graphite-to-black sweep. (The splash's ghost ₹ is left out
     here — at launcher size it reads as stray stripes, not a mark.) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="0"
                android:endX="90"
                android:endY="108">
                <item android:color="#FF1C1C1C" android:offset="0" />
                <item android:color="#FF0B0B0B" android:offset="0.55" />
                <item android:color="#FF000000" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
