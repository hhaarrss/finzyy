<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Backup is also switched off in the manifest (allowBackup="false");
     these exclusions are a second line in case that is ever turned back on. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
