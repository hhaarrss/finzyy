<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup / device transfer, Android 12+. Same exclusions as backup_rules.xml:
     the login token and per-device state never leave this install. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="smart_spend_prefs.xml" />
        <exclude domain="sharedpref" path="smartspend_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="smart_spend_prefs.xml" />
        <exclude domain="sharedpref" path="smartspend_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
