<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign in / create account. Visual design only: every view the login code in MainActivity
    touches (loginSection, tvLoginTitle, tvLoginSubtitle, llFullName, etFullName, etEmail,
    etPassword, btnLogin, btnToggleAuthMode, btnGoogleSignIn) keeps its id and view type, and
    texts the code rewrites when switching sign-in / sign-up start out identical to what it sets.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background">

    <ScrollView
        android:id="@+id/loginSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/loginContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ Hero: the splash mark on the onboarding violet ============ -->
            <FrameLayout
                android:id="@+id/loginHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/login_hero_bg"
                android:clipChildren="true"
                android:paddingTop="36dp"
                android:paddingBottom="76dp">

                <!-- Gold guilloché engraving, the same line work as the app's hero note. -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/guilloche_rosette" />

                <!-- Oversized ghost ₹ marks bleeding off opposite corners, as on the splash. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="-30dp"
                    android:layout_marginTop="-70dp"
                    android:alpha="0.07"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="₹"
                    android:textColor="@android:color/white"
                    android:textSize="210sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-36dp"
                    android:layout_marginBottom="-96dp"
                    android:alpha="0.045"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="₹"
                    android:textColor="@android:color/white"
                    android:textSize="170sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/loginBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="-24dp"
                    android:background="@drawable/login_back_bg"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_login_back" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/login_mark_bg"
                        android:elevation="10dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="₹"
                        android:textColor="@color/login_mark_ink"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="-0.02"
                        android:text="@string/app_name"
                        android:textColor="@android:color/white"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.72"
                        android:text="Your money, tracked automatically"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ============ Form card, lifted up over the hero ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-48dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/login_card_bg"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvLoginTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="@string/login_title"
                    android:textColor="@color/login_ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoginSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:lineSpacingExtra="3sp"
                    android:text="Sign in to pair your Android device with your Expense Dashboard"
                    android:textColor="@color/login_ink_soft"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/login_error_bg"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/login_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Full name: shown only in create-account mode (the code toggles llFullName). -->
                <LinearLayout
                    android:id="@+id/llFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Sign-up only: Google first, then the form. Living inside llFullName means the
                         login code's own sign-in/sign-up switch shows and hides it. -->
                    <LinearLayout
                        android:id="@+id/btnGoogleSignIn"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/login_secondary_button_bg"
                        android:clickable="true"
                        android:contentDescription="Continue with Google"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/login_google_badge_bg"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="G"
                            android:textColor="#4285F4"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="Continue with Google"
                            android:textColor="@color/login_ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- OR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/login_hairline" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:letterSpacing="0.09"
                            android:text="OR"
                            android:textColor="@color/login_ink_soft"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/login_hairline" />
                    </LinearLayout>

                    <TextView
                        style="@style/LoginFieldLabel"
                        android:text="FULL NAME" />

                    <EditText
                        android:id="@+id/etFullName"
                        style="@style/LoginField"
                        android:autofillHints="personName"
                        android:hint="Your name"
                        android:inputType="textPersonName|textCapWords" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmailLabel"
                    style="@style/LoginFieldLabel"
                    android:text="EMAIL OR PHONE" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/LoginField"
                    android:autofillHints="emailAddress"
                    android:hint="Email or phone number"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/LoginFieldLabel"
                    android:text="PASSWORD" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/LoginField"
                    android:layout_marginBottom="24dp"
                    android:autofillHints="password"
                    android:hint="Your password"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/login_primary_button_bg"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_login"
                    android:textAllCaps="false"
                    android:textColor="@color/login_on_brand"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <TextView
                    android:id="@+id/btnToggleAuthMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Don't have an account? Sign up"
                    android:textColor="@color/login_brand"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- The same privacy promise the Account page makes. -->
            <TextView
                android:id="@+id/loginFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2sp"
                android:paddingStart="36dp"
                android:paddingTop="20dp"
                android:paddingEnd="36dp"
                android:paddingBottom="28dp"
                android:text="Bank SMS are read on your phone. Only the amount, merchant and date are synced."
                android:textColor="@color/login_ink_soft"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
